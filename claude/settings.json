{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/ai/shared/scripts/auto-pull.sh\"",
            "timeout": 30,
            "statusMessage": "Syncing ai config..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/ai/claude/hooks/run-caveman-activate.sh\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/ai/claude/hooks/run-context-mode-heal.sh\"",
            "timeout": 10,
            "statusMessage": "Healing context-mode cache..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/ai/claude/hooks/run-caveman-tracker.sh\"",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/ai/shared/scripts/cross-repo-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/ai/shared/scripts/branch-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/ai/shared/scripts/stash-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/ai/shared/scripts/ast-index-bootstrap-worktree.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/dotfiles/ai/claude/hooks/caveman-statusline.sh\""
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "ast-index@ast-index-marketplace": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ast-index-marketplace": {
      "source": {
        "source": "github",
        "repo": "defendend/Claude-ast-index-search"
      }
    }
  },
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
